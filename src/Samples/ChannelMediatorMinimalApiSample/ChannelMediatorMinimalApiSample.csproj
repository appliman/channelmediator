<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.8.0" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.16.11" />
	</ItemGroup>

	<!--
		The ASP.NET Core 10 XML comment source generator assigns
		IOpenApiMediaType.Example, which is read-only in Microsoft.OpenApi 3.x.
		Disable only that compile-time generator until it supports OpenAPI.NET 3.x.
		Runtime OpenAPI document generation remains enabled.
	-->
	<Target Name="DisableIncompatibleOpenApiXmlCommentGenerator" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)"
					  Condition="'%(Analyzer.Filename)%(Analyzer.Extension)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators.dll'" />
		</ItemGroup>
	</Target>

	<ItemGroup>
    <Folder Include="_temp\" />
  </ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\ChannelMediator.ApiGenerators.Abstraction\ChannelMediator.ApiGenerators.Abstraction.csproj" />
	  <ProjectReference Include="..\..\ChannelMediator.MinimalApiGenerator\ChannelMediator.MinimalApiGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	  <ProjectReference Include="..\..\ChannelMediatorApiContractsSample\ChannelMediatorApiContractsSample.csproj" />
	  <ProjectReference Include="..\..\ChannelMediator\ChannelMediator.csproj" />
	</ItemGroup>

</Project>
